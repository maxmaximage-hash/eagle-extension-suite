{
  "manifest_version": 3,
  "name": "网页媒体保存至 Eagle",
  "version": "2.4.4",
  "description": "网页图片/视频可右键或悬浮保存；按当前平台显示整帖入口，支持 Instagram 轮播、小红书正文媒体过滤，并把图片安全转为 JPG 后导入。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["alarms", "contextMenus", "downloads", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>", "http://localhost:41595/*", "http://127.0.0.1:41595/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "保存当前网页媒体至 Eagle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["core.js", "structured-media.js", "provider-adapters.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
