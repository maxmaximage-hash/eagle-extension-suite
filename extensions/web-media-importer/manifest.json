{
  "manifest_version": 3,
  "name": "网页媒体保存至 Eagle",
  "version": "2.0.1",
  "description": "经用户确认，将归属明确并通过真实性校验的网页媒体保存至指定 Eagle 普通文件夹。",
  "permissions": ["alarms", "contextMenus", "downloads", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>", "http://localhost:41595/*", "http://127.0.0.1:41595/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "保存当前网页媒体至 Eagle", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["core.js", "structured-media.js", "provider-adapters.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
