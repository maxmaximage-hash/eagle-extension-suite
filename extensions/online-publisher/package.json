{
  "name": "max-eagle-publisher",
  "version": "1.2.7",
  "private": true,
  "description": "MAX Publisher 1.0 for Eagle watermark export and Cloudflare Pages publishing",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build:privacy": "vite build --config vite.privacy.config.mjs",
    "fonts:metadata": "swift scripts/generate-font-metadata.swift eagle-plugin/modules/font-manager/metadata.js",
    "fonts:paths": "system_profiler SPFontsDataType -json > /tmp/max-fonts-system.json && node scripts/refresh-font-paths.cjs /tmp/max-fonts-system.json",
    "preview": "node scripts/preview.cjs",
    "test:pages": "wrangler pages dev cloudflare-pages/public --persist-to .wrangler/state",
    "package:plugin": "npm run build:privacy && rm -f max-eagle-publisher-1.2.7.eagleplugin && cd eagle-plugin && zip -qr ../max-eagle-publisher-1.2.7.eagleplugin . -x '*.DS_Store'"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^6.4.3",
    "wrangler": "4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260701.1": true
  }
}
